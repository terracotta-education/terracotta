# frontend-maven-plugin logs all npm stderr output at Maven's [ERROR] level regardless of actual
# severity, so npm's own periodic "a new version of npm is available" notice (printed to stderr,
# non-deterministically based on npm's local update-check cache) shows up looking like a build
# failure even though it isn't one. Suppress it outright rather than triage it every time it fires.
update-notifier=false
