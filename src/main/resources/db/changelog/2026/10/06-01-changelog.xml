<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
    <!--
        2026/09/15-01 used to create a BEFORE INSERT trigger per uuid table, so rows inserted by
        older code during a rolling deploy still got a uuid. Every entity sets its own uuid before
        insert (UuidAwareEntity), so they're no longer needed - and creating them required SUPER or
        log_bin_trust_function_creators=1 on a server with binary logging. They were removed from
        15-01; these drop them from any database that already ran it. Each only runs where its
        trigger exists, so a database that never had them needs no trigger privilege at all.
    -->
    <changeSet author="rlong" id="1759708800000-01">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA = DATABASE() AND TRIGGER_NAME = 'trg_terr_submission_uuid'
            </sqlCheck>
        </preConditions>
        <sql>DROP TRIGGER trg_terr_submission_uuid;</sql>
    </changeSet>
