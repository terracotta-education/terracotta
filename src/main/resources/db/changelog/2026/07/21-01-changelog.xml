<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
    http://www.liquibase.org/xml/ns/pro
    http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd"
>
    <changeSet author="rlong" id="1784678400-01">
        <createTable tableName="lti_nonce">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_LTI_NONCE"/>
            </column>
            <column name="nonce" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UQ_LTI_NONCE_NONCE"/>
            </column>
            <column name="entity_version" type="INT"/>
            <column name="created_at" type="TIMESTAMP DEFAULT CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <createIndex indexName="IDX_LTI_NONCE_CREATED_AT" tableName="lti_nonce">
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
