    <changeSet author="rlong" id="1757937600000-01-trigger">
        <sql splitStatements="false" stripComments="false">
            CREATE TRIGGER trg_terr_submission_uuid BEFORE INSERT ON terr_submission
            FOR EACH ROW
            BEGIN
                IF NEW.uuid IS NULL THEN
                    SET NEW.uuid = (UUID_TO_BIN(UUID()));
                END IF;
            END;
        </sql>
        <rollback>
            DROP TRIGGER trg_terr_submission_uuid;
        </rollback>
