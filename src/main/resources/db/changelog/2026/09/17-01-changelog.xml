<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
    http://www.liquibase.org/xml/ns/pro
    http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd"
>
  <changeSet author="rlong" id="1789659504-01">
    <!-- ExperimentCopyCandidateStatus.DISMISSED was renamed to NOT_SELECTED - update any rows
         already persisted with the old value so they still deserialize correctly. -->
    <update tableName="terr_experiment_copy_candidate">
      <column name="status" value="NOT_SELECTED"/>
      <where>status = 'DISMISSED'</where>
    </update>
  </changeSet>
</databaseChangeLog>
