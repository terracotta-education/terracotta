config.stopBubbling = true

# This project depends on both jackson-databind (Jackson 2, com.fasterxml.jackson) and the
# newer tools.jackson (Jackson 3) libraries for different connectors. Declare both as
# acceptable @Jacksonized variants so Lombok picks per-class based on each file's own
# imports instead of raising the "Jackson2 and Jackson3 exist" ambiguity warning.
lombok.jacksonized.jacksonVersion += 2
lombok.jacksonized.jacksonVersion += 3
